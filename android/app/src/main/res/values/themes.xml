<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Clay background from the first frame, so the app does not flash white while starting. -->
    <style name="Theme.LazyScheduler" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/clay</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
