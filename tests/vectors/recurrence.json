{
  "about": "Recurrence engine specification. Any implementation (desktop Python, a future mobile/sync client) must produce exactly these dates. Dates were worked out by hand from the calendar, not generated by the engine. They assume the built-in Korean public holiday table for 2026-2027 and no extra holidays. Windows are inclusive.",
  "cases": [
    {
      "name": "monthly 1st, weekend and New Year's Day shift to previous business day across the month boundary",
      "rule": {"period": "month", "basis": "day", "n": 1, "holiday_shift": "prev"},
      "start": "2026-09-01", "end": "2026-12-31",
      "expect": ["2026-09-01", "2026-10-01", "2026-10-30", "2026-12-01", "2026-12-31"]
    },
    {
      "name": "monthly 2nd business day",
      "rule": {"period": "month", "basis": "business_day", "n": 2, "holiday_shift": "prev"},
      "start": "2026-09-01", "end": "2026-12-31",
      "expect": ["2026-09-02", "2026-10-02", "2026-11-03", "2026-12-02"]
    },
    {
      "name": "monthly last business day",
      "rule": {"period": "month", "basis": "business_day", "n": -1, "holiday_shift": "prev"},
      "start": "2026-09-01", "end": "2026-12-31",
      "expect": ["2026-09-30", "2026-10-30", "2026-11-30", "2026-12-31"]
    },
    {
      "name": "monthly 3 business days before month end (skips Chuseok)",
      "rule": {"period": "month", "basis": "before_end_bd", "k": 3, "holiday_shift": "prev"},
      "start": "2026-09-01", "end": "2026-10-31",
      "expect": ["2026-09-23", "2026-10-27"]
    },
    {
      "name": "monthly last Thursday, Chuseok Thursday shifts back",
      "rule": {"period": "month", "basis": "weekday", "n": -1, "weekday": 3, "holiday_shift": "prev"},
      "start": "2026-09-01", "end": "2026-12-31",
      "expect": ["2026-09-23", "2026-10-29", "2026-11-26", "2026-12-31"]
    },
    {
      "name": "monthly last calendar day, weekend shifts forward into next month",
      "rule": {"period": "month", "basis": "day", "n": -1, "holiday_shift": "next"},
      "start": "2026-10-15", "end": "2026-11-30",
      "expect": ["2026-11-02", "2026-11-30"]
    },
    {
      "name": "yearly Dec 25 shifted to previous business day",
      "rule": {"period": "month", "basis": "day", "n": 25, "months": [12], "holiday_shift": "prev"},
      "start": "2026-01-01", "end": "2026-12-31",
      "expect": ["2026-12-24"]
    },
    {
      "name": "yearly Dec 25 without shifting",
      "rule": {"period": "month", "basis": "day", "n": 25, "months": [12], "holiday_shift": "none"},
      "start": "2026-01-01", "end": "2026-12-31",
      "expect": ["2026-12-25"]
    },
    {
      "name": "quarterly 1st business day (New Year's Day 2027 is a holiday)",
      "rule": {"period": "quarter", "basis": "business_day", "n": 1, "holiday_shift": "prev"},
      "start": "2026-07-01", "end": "2027-01-31",
      "expect": ["2026-07-01", "2026-10-01", "2027-01-04"]
    },
    {
      "name": "weekly Friday, holidays shift to previous business day",
      "rule": {"period": "week", "weekdays": [4], "interval": 1, "holiday_shift": "prev"},
      "start": "2026-09-14", "end": "2026-10-11",
      "expect": ["2026-09-18", "2026-09-23", "2026-10-02", "2026-10-08"]
    },
    {
      "name": "biweekly Monday anchored on 2026-09-07, substitute holiday shifts back to Friday",
      "rule": {"period": "week", "weekdays": [0], "interval": 2, "anchor": "2026-09-07", "holiday_shift": "prev"},
      "start": "2026-09-01", "end": "2026-10-25",
      "expect": ["2026-09-07", "2026-09-21", "2026-10-02", "2026-10-19"]
    },
    {
      "name": "every business day around Chuseok",
      "rule": {"period": "day", "business_only": true},
      "start": "2026-09-21", "end": "2026-09-27",
      "expect": ["2026-09-21", "2026-09-22", "2026-09-23"]
    }
  ]
}
